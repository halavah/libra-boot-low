<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back :title="id ? '编辑{{ master_module.name }}' : '新增{{ master_module.name }}'" @go-back="handleBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <el-form ref="formRef" :model="form" :rules="rules" label-width="auto" v-loading="loading">
          <el-row :gutter="20">

{% for field in master_fields %}{% if not field.generated %}
{% if field.type == 'input' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-input v-model="form.{{ field.name }}" placeholder="请输入{{ field.label }}" clearable />
            </el-form-item>
          </el-col>
{% elif field.type == 'textarea' %}
          <el-col :span="24">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-input v-model="form.{{ field.name }}" type="textarea" :rows="3" placeholder="请输入{{ field.label }}" />
            </el-form-item>
          </el-col>
{% elif field.type == 'number' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-input-number v-model="form.{{ field.name }}" :min="0" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'decimal' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-input-number v-model="form.{{ field.name }}" :precision="2" :min="0" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'date' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-date-picker v-model="form.{{ field.name }}" type="date" value-format="YYYY-MM-DD" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'datetime' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-date-picker v-model="form.{{ field.name }}" type="datetime" value-format="YYYY-MM-DD HH:mm:ss" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'date-year' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-date-picker v-model="form.{{ field.name }}" type="year" value-format="YYYY" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'date-month' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-date-picker v-model="form.{{ field.name }}" type="month" value-format="YYYY-MM" style="width: 100%" />
            </el-form-item>
          </el-col>
{% elif field.type == 'select' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
              <el-select v-model="form.{{ field.name }}" placeholder="请选择{{ field.label }}" clearable style="width: 100%">
{% for option in field.options %}
                <el-option label="{{ option.label }}" :value="{{ option.value }}" />
{% endfor %}
              </el-select>
            </el-form-item>
          </el-col>
{% endif %}
{% endif %}{% endfor %}

          </el-row>
        </el-form>
      </el-card>

{% if has_master_file %}
      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">附件材料</span></div>
        </template>
        <el-upload
          ref="uploadRef"
          :http-request="handleUpload"
          :before-upload="beforeUpload"
          :on-remove="handleRemove"
          :on-preview="handlePreview"
          :file-list="uiFileList"
          multiple
        >
          <el-button type="primary">点击上传</el-button>
          <template #tip>
            <div class="el-upload__tip">{% if master_module.file_types and master_module.file_types | length > 0 %}支持上传{% for ft in master_module.file_types %}{{ ft.label }}{% if not loop.last %}、{% endif %}{% endfor %}等文件，{% endif %}单文件不超过50MB</div>
          </template>
        </el-upload>
      </el-card>
{% endif %}

      <!-- 仅编辑模式（有 id）时显示明细 Tab -->
      <el-card v-if="props.id" class="mb-20">
        <el-tabs v-model="activeTab">
          {% for dm in detail_modules %}
          <el-tab-pane label="{{ dm.name }}" name="{{ dm.code }}">
            <{{ module.code }}-{{ dm.code }}-manage :master-id="props.id" :is-embedded="true" />
          </el-tab-pane>
          {% endfor %}
        </el-tabs>
      </el-card>

      <el-card class="mb-20">
        <el-button type="primary" :loading="submitLoading" @click="handleSubmit">确认</el-button>
        <el-button @click="handleBack">取消</el-button>
      </el-card>

      <div style="height: 150px"></div>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from "vue"
import { ElMessage } from "element-plus"
import masterApi from "@/service/{{ module.domain }}/{{ group_code }}.js"
{% for dm in detail_modules %}
import {{ module.code_pascal }}{{ dm.code_pascal }}Manage from "./{{ module.code }}-{{ dm.code }}-manage.vue"
{% endfor %}

const props = defineProps({
  id: { type: String, default: '' }
})

const emit = defineEmits(['call-back-data'])

const activeTab = ref("{{ detail_modules[0].code if detail_modules else '' }}")
const formRef = ref(null)
{% if has_master_file %}
const uploadRef = ref(null)
{% endif %}
const loading = ref(false)
const submitLoading = ref(false)
{% if has_master_file %}
const uiFileList = ref([]) // el-upload 显示用的文件列表
const uploadedFiles = ref([]) // 已上传文件列表
const is_uploadedFileList = ref(false)
{% endif %}

const form = reactive({
{% for field in master_fields %}{% if not field.generated %}  {{ field.name }}: {% if field.type == 'select' or field.type == 'date' or field.type == 'datetime' or field.type == 'date-year' or field.type == 'date-month' %}""{% elif field.type == 'number' or field.type == 'decimal' %}0{% else %}""{% endif %},
{% endif %}{% endfor %}{% if has_master_file %}
  fileList: [] // 提交时的文件列表
{% endif %}
})

const rules = {
{% for field in master_fields %}{% if field.required and not field.generated %}  {{ field.name }}: [{ required: true, message: "{% if field.type == 'select' %}请选择{% else %}请输入{% endif %}{{ field.label }}", trigger: "{% if field.type == 'select' %}change{% else %}blur{% endif %}" }],
{% endif %}{% endfor %}
}

{% if has_master_file %}
// 上传前校验
const beforeUpload = (file) => {
  const isLt50M = file.size / 1024 / 1024 < 50
  if (!isLt50M) {
    ElMessage.error('文件大小不能超过50MB!')
    return false
  }
  return true
}

// 获取附件列表
const getFileList = () => {
  if (!props.id) return
  masterApi.getMasterFileList(props.id).then((res) => {
    uploadedFiles.value = res || []
    uiFileList.value = (res || []).map((f) => ({ name: f.fileName, url: f.fileUrl }))
  }).catch(() => {
    uploadedFiles.value = []
    uiFileList.value = []
  })
}

// 自定义上传方法（携带 Token）
const handleUpload = (options) => {
  const formData = new FormData()
  formData.append('file', options.file)
  is_uploadedFileList.value = true
  masterApi.upload{{ master_module.code_pascal }}File(formData).then((res) => {
    if (res) {
      // 添加到 form.fileList（用于提交）
      form.fileList.push({
        fileType: '{% if master_module.file_types and master_module.file_types | length > 0 %}{{ master_module.file_types[0].code }}{% else %}annex{% endif %}',
        fileUrl: res.fileUrl,
        fileName: res.fileName
      })
      // 添加到 uiFileList（用于显示）
      uiFileList.value.push({
        name: res.fileName,
        url: res.fileUrl,
        uid: options.file.uid
      })
      ElMessage.success('附件上传成功')
      options.onSuccess(res, options.file)
    }
  }).catch((err) => {
    ElMessage.error('上传失败')
    options.onError(err)
  }).finally(() => {
    is_uploadedFileList.value = false
  })
}

// 移除文件
const handleRemove = (file) => {
  const idx = form.fileList.findIndex(f => f.fileName === file.name)
  if (idx > -1) {
    form.fileList.splice(idx, 1)
  }
  const uiIdx = uiFileList.value.findIndex(f => f.uid === file.uid)
  if (uiIdx > -1) {
    uiFileList.value.splice(uiIdx, 1)
  }
}

// 预览文件（el-upload 内部 file.url 在新上传时为 blob: URL，从 uiFileList 查找真实 MinIO URL）
const handlePreview = (file) => {
  const found = uiFileList.value.find(f => f.name === file.name)
  const url = (found && found.url) ? found.url : file.url
  if (url) window.open(url, '_blank')
}
{% endif %}

// 日期字段标准化：兼容 number / ISO / 普通字符串 → 控件所需格式（字符串截取，不做时区换算）
const normalizeDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

// 加载详情
const getDetail = () => {
  if (!props.id) return
  loading.value = true
  masterApi.getMasterDetail(props.id).then((res) => {
    if (res) {
      Object.keys(form).forEach((key) => {
{% if has_master_file %}
        if (key !== "fileList" && res[key] !== undefined) form[key] = res[key]
{% else %}
        if (res[key] !== undefined) form[key] = res[key]
{% endif %}
      })
{% for field in master_fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] and not field.generated %}      form.{{ field.name }} = normalizeDateField(form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}{% if has_master_file %}
      getFileList()
{% endif %}
    }
  }).finally(() => { loading.value = false })
}

const handleSubmit = () => {
  formRef.value.validate((valid) => {
    if (!valid) return
    if (is_uploadedFileList.value) {
      ElMessage.warning("附件正在上传中，请稍候...")
      return
    }
    submitLoading.value = true
    const data = { ...form, ...(props.id ? { id: props.id } : {}) }
    const request = props.id ? masterApi.updateMaster(data) : masterApi.addMaster(data)
    request.then(() => {
      ElMessage.success(props.id ? "编辑成功" : "新增成功")
      emit("call-back-data", 1)
    }).finally(() => { submitLoading.value = false })
  })
}

const handleBack = () => {
  emit("call-back-data", 0)
}

onMounted(() => {
  getDetail()
})
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
