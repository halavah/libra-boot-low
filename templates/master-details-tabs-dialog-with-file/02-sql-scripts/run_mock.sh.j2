#!/bin/bash
# ==============================================================================
# 【脚本定位】
#   02-sql-scripts/run_mock.sh — run_mock.py 的 Linux/Mac 包装器
#   本脚本不含任何业务逻辑，职责单一：
#     1. 检查运行环境（Python + 依赖）
#     2. 将所有参数原样透传给 run_mock.py
#   真正的执行逻辑全部在 run_mock.py 中，两者分工明确。
#
# 【设计思路】
#   1. 薄包装原则
#      Shell 脚本只做"启动器"，不重复实现业务逻辑。
#      这样维护时只需修改 run_mock.py，sh/ps1 无需同步改动。
#
#   2. 参数透传
#      "$@" 将调用者传入的所有参数原封不动地转给 Python，
#      支持：无参数（交互菜单）、带模式参数、带 --yes 跳过确认。
#      示例：
#        ./run_mock.sh          → 进入交互菜单
#        ./run_mock.sh 0 --yes  → 非交互全量重置（自动化专用）
#
#   3. 依赖前置检查
#      在执行前统一检查 PyYAML、PyMySQL，
#      给出明确的安装提示后退出，避免 Python 在深层报出难懂的 ImportError。
#
#   4. python3 优先
#      优先使用 python3，其次回退到 python，
#      兼容不同 Linux 发行版和 macOS 的 Python 安装方式。
#
# 【执行流程】
#   启动
#     ↓ 定位脚本目录（SCRIPT_DIR）
#     ↓ 检查 python3 是否存在
#     ↓ 检查 PyYAML、PyMySQL 依赖
#     ↓ 所有检查通过 → python3 run_mock.py "$@"
#     └─ 任意检查失败 → 打印提示 → exit 1
#
# 【调用关系】
#   ┌──────────────────────────────────────────────────────────┐
#   │  手动执行        ./run_mock.sh                           │
#   │  手动执行        ./run_mock.sh 0 --yes                   │
#   │  L3闭环脚本调用  ./run_mock.sh 0 --yes（自动化场景）     │
#   └──────────────────────────────────────────────────────────┘
#   注意：test_mock.py 会直接调用 run_mock.py（Python→Python），
#         不经过本 sh 包装器，以避免子 Shell 的开销。
#
# 【注意事项】
#   - 首次使用前需赋予执行权限：chmod +x run_mock.sh
#   - 依赖安装：pip3 install pyyaml pymysql
#   - 数据库配置位于 ../../../../.claude/.env
# ==============================================================================

# 获取脚本所在目录（兼容符号链接调用）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "========================================"
echo "  {{ module.code.upper() }} 模块 - SQL执行工具 (Linux/Mac)"
echo "========================================"

# ---- 检查 Python 是否安装 ----
if ! command -v python3 &> /dev/null; then
    echo "错误: 未找到 python3，请先安装 Python 3"
    exit 1
fi

echo "✓ Python: $(python3 --version)"

# ---- 检查依赖 ----
MISSING_DEPS=0

if ! python3 -c "import yaml" 2>/dev/null; then
    echo "✗ 缺少依赖: PyYAML"
    MISSING_DEPS=1
fi

if ! python3 -c "import pymysql" 2>/dev/null; then
    echo "✗ 缺少依赖: PyMySQL"
    MISSING_DEPS=1
fi

if [ $MISSING_DEPS -eq 1 ]; then
    echo ""
    echo "请先安装依赖:"
    echo "  pip3 install pyyaml pymysql"
    exit 1
fi

echo "✓ 依赖检查通过"
echo ""

# ---- 透传所有参数给 Python 核心脚本 ----
# 支持：无参数（交互菜单）/ 带参数（命令行模式，如 0 --yes）
python3 "$SCRIPT_DIR/run_mock.py" "$@"
