<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back :title="id ? '编辑{{ detail_module.name }}' : '新增{{ detail_module.name }}'" @go-back="handleBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <el-form ref="formRef" :model="form" :rules="rules" label-width="auto" v-loading="loading">
          <el-row :gutter="20">

          <!-- 关联{{ master_module.name }}选择 -->
          <el-col :span="12">
            <el-form-item label="{{ master_module.name }}" prop="{{ master_module.code }}Id">
            <el-select
              v-model="form.{{ master_module.code }}Id"
              placeholder="请选择{{ master_module.name }}"
              filterable
              :disabled="!!props.{{ master_module.code }}Id"
              style="width: 100%"
            >
              <el-option v-for="item in masterList" :key="item.id" :label="item.{{ master_display_field | default('name') }} || item.id" :value="item.id" />
            </el-select>
          </el-form-item>
          </el-col>

{% for field in detail_fields %}{% if not field.generated %}
{% if field.type == 'input' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input v-model="form.{{ field.name }}" placeholder="请输入{{ field.label }}" clearable />
          </el-form-item>
          </el-col>
{% elif field.type == 'textarea' %}
          <el-col :span="24">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input v-model="form.{{ field.name }}" type="textarea" :rows="3" placeholder="请输入{{ field.label }}" />
          </el-form-item>
          </el-col>
{% elif field.type == 'number' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input-number v-model="form.{{ field.name }}" :min="0" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'decimal' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input-number v-model="form.{{ field.name }}" :precision="2" :min="0" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="date" value-format="YYYY-MM-DD" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'datetime' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="datetime" value-format="YYYY-MM-DD HH:mm:ss" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date-year' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="year" value-format="YYYY" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date-month' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="month" value-format="YYYY-MM" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'select' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-select v-model="form.{{ field.name }}" placeholder="请选择{{ field.label }}" clearable style="width: 100%">
{% for option in field.options %}
              <el-option label="{{ option.label }}" :value="{{ option.value }}" />
{% endfor %}
            </el-select>
          </el-form-item>
          </el-col>
{% endif %}
{% endif %}{% endfor %}

          <el-col :span="24">
            <el-form-item>
            <el-button type="primary" :loading="submitting" @click="handleSubmit">确认</el-button>
            <el-button @click="handleBack">取消</el-button>
          </el-form-item>
          </el-col>

          </el-row>
</el-form>
      </el-card>

      <div style="height: 150px"></div>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from "vue"
import { ElMessage } from "element-plus"
import api from "@/service/{{ module.domain }}/{{ group_code }}.js"

const props = defineProps({
  id: { type: String, default: "" },
  {{ master_module.code }}Id: { type: String, default: "" }
})
const emit = defineEmits(["call-back-data"])

const formRef = ref(null)
const loading = ref(false)
const submitting = ref(false)
const masterList = ref([])

const form = reactive({
  {{ master_module.code }}Id: "",
{% for field in detail_fields %}{% if not field.generated %}  {{ field.name }}: {% if field.type == 'select' or field.type == 'date' or field.type == 'datetime' or field.type == 'date-year' or field.type == 'date-month' %}""{% elif field.type == 'number' or field.type == 'decimal' %}0{% else %}""{% endif %},
{% endif %}{% endfor %}})

const rules = {
  {{ master_module.code }}Id: [{ required: true, message: "请选择{{ master_module.name }}", trigger: "change" }],
{% for field in detail_fields %}{% if field.required and not field.generated %}  {{ field.name }}: [{ required: true, message: "{% if field.type == 'select' %}请选择{% else %}请输入{% endif %}{{ field.label }}", trigger: "{% if field.type == 'select' %}change{% else %}blur{% endif %}" }],
{% endif %}{% endfor %}}

// 日期字段标准化：兼容 number / ISO / 普通字符串 → 控件所需格式（字符串截取，不做时区换算）
const normalizeDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

onMounted(() => {
  // 预填充父ID
  if (props.{{ master_module.code }}Id) form.{{ master_module.code }}Id = props.{{ master_module.code }}Id
  // 加载主表下拉
  api.getMasterList({ current: 1, size: 1000 }).then((res) => {
    masterList.value = res.records || []
  })
  // 加载详情（编辑模式）
  if (props.id) {
    loading.value = true
    api.get{{ detail_module.code_pascal }}Detail(props.id).then((res) => {
      if (res) {
        Object.assign(form, res)
{% for field in detail_fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] %}        form.{{ field.name }} = normalizeDateField(form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}      }
    }).finally(() => { loading.value = false })
  }
})

const handleSubmit = () => {
  formRef.value.validate((valid) => {
    if (!valid) return
    submitting.value = true
    const data = { ...form, ...(props.id ? { id: props.id } : {}) }
    const request = props.id ? api.update{{ detail_module.code_pascal }}(data) : api.add{{ detail_module.code_pascal }}(data)
    request.then(() => {
      ElMessage.success(props.id ? "编辑成功" : "新增成功")
      emit("call-back-data", 1)
    }).finally(() => { submitting.value = false })
  })
}

const handleBack = () => {
  emit("call-back-data", 0)
}
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
