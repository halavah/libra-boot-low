<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back title="{{ module.name }}详情" @go-back="goBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <el-descriptions :column="2" border>
{% for field in fields %}{% if not field.generated %}
{% if field.type == 'select' and field.options %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} get{{ field.name_pascal }}Label(info.{{ field.name }}) {{ '}}' }}</el-descriptions-item>
{% elif field.type in ['date-year', 'date-month', 'date', 'datetime'] %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} formatDateField(info.{{ field.name }}, '{{ field.type }}') {{ '}}' }}</el-descriptions-item>
{% else %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} info.{{ field.name }} {{ '}}' }}</el-descriptions-item>
{% endif %}
{% endif %}{% endfor %}
          <el-descriptions-item label="创建时间">{{ '{{' }} formatDateField(info.createTime, 'datetime') {{ '}}' }}</el-descriptions-item>
        </el-descriptions>
      </el-card>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, onMounted } from "vue"
import api from "@/service/{{ module.domain }}/{{ module.code }}.js"

const props = defineProps({
  id: String
})
const emit = defineEmits(["call-back-data"])

const info = ref({})

{% for field in fields %}{% if field.type == 'select' and field.options %}
const {{ field.name }}Map = {
{% for opt in field.options %}  '{{ opt.value }}': '{{ opt.label }}',
{% endfor %}
}
const get{{ field.name_pascal }}Label = (val) => {
  return {{ field.name }}Map[val] || val
}
{% endif %}{% endfor %}

const formatDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

onMounted(() => {
  if (props.id) {
    api.getDetail(props.id).then((res) => {
      info.value = res || {}
    })
  }
})

const goBack = () => {
  emit("call-back-data", 0)
}
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
