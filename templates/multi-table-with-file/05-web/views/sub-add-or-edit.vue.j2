<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back :title="id ? '编辑{{ module.name }}' : '新增{{ module.name }}'" @go-back="handleBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <el-form ref="formRef" :model="form" :rules="rules" label-width="auto" v-loading="loading">
          <el-row :gutter="20">

{% for field in fields %}{% if not field.generated %}
          <el-col :span="24">
            <el-form-item label="{{ field.label }}"{% if field.required %} prop="{{ field.name }}"{% endif %}>
{% if field.type == 'input' %}
            <el-input v-model="form.{{ field.name }}" placeholder="请输入{{ field.label }}" clearable />
{% elif field.type == 'textarea' %}
            <el-input v-model="form.{{ field.name }}" type="textarea" :rows="3" placeholder="请输入{{ field.label }}" />
{% elif field.type == 'select' %}
            <el-select v-model="form.{{ field.name }}" placeholder="请选择{{ field.label }}" style="width:100%" clearable>
{% if field.options %}{% for opt in field.options %}
              <el-option label="{{ opt.label }}" :value="{{ opt.value }}" />
{% endfor %}{% endif %}
            </el-select>
{% elif field.type == 'date' %}
            <el-date-picker v-model="form.{{ field.name }}" type="date" placeholder="请选择{{ field.label }}" format="YYYY-MM-DD" value-format="YYYY-MM-DD" style="width:100%" />
{% elif field.type == 'datetime' %}
            <el-date-picker v-model="form.{{ field.name }}" type="datetime" placeholder="请选择{{ field.label }}" format="YYYY-MM-DD HH:mm:ss" value-format="YYYY-MM-DD HH:mm:ss" style="width:100%" />
{% elif field.type == 'date-year' %}
            <el-date-picker v-model="form.{{ field.name }}" type="year" placeholder="请选择{{ field.label }}" format="YYYY" value-format="YYYY" style="width:100%" />
{% elif field.type == 'date-month' %}
            <el-date-picker v-model="form.{{ field.name }}" type="month" placeholder="请选择{{ field.label }}" format="YYYY-MM" value-format="YYYY-MM" style="width:100%" />
{% elif field.type == 'number' or field.type == 'decimal' %}
            <el-input-number v-model="form.{{ field.name }}" :precision="{{ 2 if field.type == 'decimal' else 0 }}" style="width:100%" />
{% else %}
            <el-input v-model="form.{{ field.name }}" placeholder="请输入{{ field.label }}" clearable />
{% endif %}
          </el-form-item>
          </el-col>
{% endif %}{% endfor %}

          </el-row>
</el-form>
      </el-card>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">附件材料</span></div>
        </template>
        <el-upload
          ref="uploadRef"
          :action="uploadAction"
          :before-upload="beforeUpload"
          :on-success="handleUploadSuccess"
          :on-remove="handleRemove"
          :on-preview="handlePreview"
          :file-list="uiFileList"
          :auto-upload="true"
          multiple
        >
          <el-button type="primary">点击上传</el-button>
          <template #tip>
            <div class="el-upload__tip">{% if module.file_types and module.file_types | length > 0 %}支持上传{% for ft in module.file_types %}{{ ft.label }}{% if not loop.last %}、{% endif %}{% endfor %}等文件，{% endif %}单文件不超过50MB</div>
          </template>
        </el-upload>
      </el-card>

      <el-card class="mb-20">
        <el-button type="primary" :loading="submitLoading" @click="handleSubmit">确认</el-button>
        <el-button @click="handleBack">取消</el-button>
      </el-card>

      <div style="height: 150px"></div>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, reactive, computed, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import api from "@/service/{{ module.domain }}/{{ group_code }}.js"

const props = defineProps({
  id: { type: String, default: '' }
})
const emit = defineEmits(['call-back-data'])

const formRef = ref(null)
const uploadRef = ref(null)
const loading = ref(false)
const submitLoading = ref(false)
const uiFileList = ref([]) // el-upload 显示用的文件列表
const uploadedFiles = ref([]) // 已上传文件列表
const is_uploadedFileList = ref(false)

const form = reactive({
{% for field in fields %}{% if not field.generated %}  {{ field.name }}: {% if field.type == 'number' or field.type == 'decimal' %}null{% else %}''{% endif %},
{% endif %}{% endfor %}  fileList: [] // 提交时的文件列表
})

const rules = {
{% for field in fields %}{% if field.required and not field.generated %}  {{ field.name }}: [{ required: true, message: '{{ field.label }}不能为空', trigger: 'blur' }],
{% endif %}{% endfor %}}

// 上传配置
const uploadAction = computed(() => {
  return `${import.meta.env.VITE_API_URL}/api/layer/v1/sys-service{{ module.api_path }}/upload`
})

// 获取附件列表
const getFileList = () => {
  if (!props.id) return
  api.get{{ module.code_pascal }}FileList(props.id).then((res) => {
    uploadedFiles.value = res || []
    uiFileList.value = (res || []).map((f) => ({ name: f.fileName, url: f.fileUrl }))
  }).catch(() => {
    uploadedFiles.value = []
    uiFileList.value = []
  })
}

// 上传前校验
const beforeUpload = (file) => {
  const isLt50M = file.size / 1024 / 1024 < 50
  if (!isLt50M) {
    ElMessage.error('文件大小不能超过50MB!')
    return false
  }
  is_uploadedFileList.value = true
  return true
}

// 上传成功回调
const handleUploadSuccess = (response, file) => {
  if (response.success) {
    form.fileList.push({
      fileType: '{% if module.file_types and module.file_types | length > 0 %}{{ module.file_types[0].code }}{% else %}annex{% endif %}',
      fileUrl: response.data.fileUrl,
      fileName: response.data.fileName
    })
    uiFileList.value.push({
      name: response.data.fileName,
      url: response.data.fileUrl,
      uid: file.uid
    })
    ElMessage.success('上传成功')
  } else {
    ElMessage.error(response.msg || '上传失败')
  }
  is_uploadedFileList.value = false
}

// 移除文件
const handleRemove = (file) => {
  const idx = form.fileList.findIndex(f => f.fileName === file.name)
  if (idx > -1) form.fileList.splice(idx, 1)
  const uiIdx = uiFileList.value.findIndex(f => f.uid === file.uid)
  if (uiIdx > -1) uiFileList.value.splice(uiIdx, 1)
}

// 预览文件（el-upload 内部 file.url 在新上传时为 blob: URL，从 uiFileList 查找真实 MinIO URL）
const handlePreview = (file) => {
  const found = uiFileList.value.find(f => f.name === file.name)
  const url = (found && found.url) ? found.url : file.url
  if (url) window.open(url, '_blank')
}

// 日期字段标准化：兼容 number / ISO / 普通字符串 → 控件所需格式（字符串截取，不做时区换算）
const normalizeDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

onMounted(() => {
  if (props.id) {
    loading.value = true
    api.get{{ module.code_pascal }}Detail({ id: props.id }).then((res) => {
      if (res) {
        Object.keys(form).forEach(key => {
          if (key !== 'fileList' && res[key] !== undefined) form[key] = res[key]
        })
{% for field in fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] %}        form.{{ field.name }} = normalizeDateField(form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}        // 加载附件列表
        getFileList()
      }
    }).finally(() => {
      loading.value = false
    })
  }
})

const handleBack = () => emit('call-back-data', 0)

const handleSubmit = () => {
  formRef.value.validate((valid) => {
    if (!valid) return
    // 等待附件上传完成
    if (is_uploadedFileList.value) {
      ElMessage.warning('附件正在上传中，请稍候...')
      return
    }
    submitLoading.value = true
    const fn = props.id ? api.update{{ module.code_pascal }} : api.add{{ module.code_pascal }}
    fn({ ...form, ...(props.id ? { id: props.id } : {}) })
      .then(() => {
        ElMessage.success(props.id ? '修改成功' : '新增成功')
        is_uploadedFileList.value = false
        emit('call-back-data', 1)
      })
      .finally(() => {
        submitLoading.value = false
      })
  })
}
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
