<template>
  <div class="{{ group_code }}-{{ module.code }}-detail" v-loading="loading" element-loading-text="加载中…">
    <el-scrollbar>
      <G-back title="{{ module.name }}详情" @go-back="goBack"></G-back>

      <!-- 基本信息 -->
      <el-card style="margin: 12px 20px">
        <el-descriptions :column="2" border>
{% for field in fields %}{% if not field.generated %}
{% if field.type == 'select' and field.options %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} get{{ field.name_pascal }}Label(info.{{ field.name }}) {{ '}}' }}</el-descriptions-item>
{% elif field.type in ['date-year', 'date-month', 'date', 'datetime'] %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} formatDateField(info.{{ field.name }}, '{{ field.type }}') {{ '}}' }}</el-descriptions-item>
{% else %}
          <el-descriptions-item label="{{ field.label }}">{{ '{{' }} info.{{ field.name }} {{ '}}' }}</el-descriptions-item>
{% endif %}
{% endif %}{% endfor %}
          <el-descriptions-item label="创建时间">{{ '{{' }} formatDateField(info.createTime, 'datetime') {{ '}}' }}</el-descriptions-item>
        </el-descriptions>
      </el-card>

      <!-- 附件列表 -->
      <el-card v-if="info.fileList && info.fileList.length > 0" style="margin: 12px 20px">
        <template #header>
          <span>附件材料</span>
        </template>
        <div class="file-list">
          <div v-for="(file, index) in info.fileList" :key="index" class="file-item">
            <el-icon style="margin-right: 6px; vertical-align: middle;"><Document /></el-icon>
            <el-link :href="file.fileUrl" target="_blank" type="primary">{{ '{{' }} file.fileName {{ '}}' }}</el-link>
          </div>
        </div>
      </el-card>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { Document } from '@element-plus/icons-vue'
import api from '@/service/{{ module.domain }}/{{ group_code }}.js'

const props = defineProps({
  id: { type: String, default: '' }
})
const emit = defineEmits(['call-back-data'])

const loading = ref(false)
const info = ref({ fileList: [] })

{% for field in fields %}{% if field.type == 'select' and field.options %}
const {{ field.name }}Map = {
{% for opt in field.options %}  '{{ opt.value }}': '{{ opt.label }}',
{% endfor %}
}
const get{{ field.name_pascal }}Label = (val) => {
  return {{ field.name }}Map[val] || val
}
{% endif %}{% endfor %}

const formatDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

const fileTypeMap = {
{% for ft in module.file_types %}  {{ ft.code }}: '{{ ft.label }}',
{% endfor %}
}

const getFileTypeLabel = (code) => {
  return fileTypeMap[code] || code
}

onMounted(async () => {
  if (props.id) {
    loading.value = true
    try {
      const res = await api.get{{ module.code_pascal }}Detail({ id: props.id })
      info.value = res || {}
      // 加载附件列表
      try {
        const files = await api.get{{ module.code_pascal }}FileList({ id: props.id })
        info.value.fileList = files || []
      } catch (e) { info.value.fileList = [] }
    } finally {
      loading.value = false
    }
  }
})

const goBack = () => emit('call-back-data', 0)
</script>

<style lang="scss" scoped>
.{{ group_code }}-{{ module.code }}-detail {
  .file-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    .file-item {
      display: flex;
      align-items: center;
      font-size: 14px;
    }
  }
}
</style>
