#!/bin/bash
# ==============================================================================
# 【脚本定位】
#   03-http-scripts/gen_mock.sh — gen_mock.py 的 Linux/Mac 包装器
#   职责单一：检查运行环境（Python 是否可用）后，将调用原样转给
#   gen_mock.py。所有生成逻辑均在 gen_mock.py 中实现，本脚本不含
#   任何业务逻辑。
#
# 【设计思路】
#   1. 薄包装原则
#      Shell 脚本只做"启动器"，不重复实现业务逻辑。
#      维护时只需修改 gen_mock.py，sh/ps1 无需同步改动。
#
#   2. python3 优先回退策略
#      先尝试 python3，不存在再尝试 python，兼容不同 Linux 发行版
#      和 macOS 的 Python 安装方式（Homebrew / 系统自带 / pyenv 等）。
#
#   3. 参数透传
#      "$@" 将调用者传入的所有参数原封不动地转给 Python，
#      支持 gen_mock.py 的所有命令行参数：
#        --dir  <目录>      指定扫描的 .http 文件目录（默认 ../03-http）
#        --name <集合名称>  自定义生成的 Postman 集合名称
#      示例：
#        ./gen_mock.sh                          → 使用默认参数生成
#        ./gen_mock.sh --name "我的测试集合"    → 自定义集合名称
#        ./gen_mock.sh --dir /path/to/http      → 指定 .http 目录
#
#   4. 轻量依赖
#      gen_mock.py 只使用 Python 标准库，无需 pip 安装任何依赖，
#      因此本脚本省略了依赖检查步骤（与 run_mock.sh 不同）。
#
# 【执行流程】
#   启动
#     ↓ 定位脚本目录（SCRIPT_DIR）
#     ↓ 确认 gen_mock.py 存在
#     ↓ 探测 python3 / python 命令
#     ↓ 执行：python3 gen_mock.py "$@"
#     └─ 任意步骤失败 → 打印错误 → exit 1
#
# 【调用关系】
#   ┌──────────────────────────────────────────────────────────┐
#   │  手动执行    ./gen_mock.sh                               │
#   │  手动执行    ./gen_mock.sh --name "xxx"                  │
#   │  不被任何脚本自动调用（纯手动工具）                      │
#   └──────────────────────────────────────────────────────────┘
#   输出文件：../05-out/{module}_{YYYYMMDD_HHmmss}.json
#   用途：导入 Postman / Apifox 进行可视化接口调试
#
# 【注意事项】
#   - 首次使用前需赋予执行权限：chmod +x gen_mock.sh
#   - 输出目录 ../05-out/ 不存在时 gen_mock.py 会自动创建
#   - baseUrl 硬编码为 127.0.0.1:9072，如需修改请编辑 gen_mock.py
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/gen_mock.py"

echo "=========================================="
echo "  通用模块 - Postman 集合生成器"
echo "=========================================="

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "Error: gen_mock.py not found."
    exit 1
fi

# ---- 探测 Python 命令（python3 优先，回退到 python）----
if command -v python3 &> /dev/null; then
    PYTHON="python3"
elif command -v python &> /dev/null; then
    PYTHON="python"
else
    echo "Error: Python not found. Please install Python 3."
    exit 1
fi

echo "✓ Python: $($PYTHON --version)"
echo ""

# ---- 透传所有参数给 Python 核心脚本 ----
# 支持：无参数（默认生成）/ 带参数（如 --name / --dir）
"$PYTHON" "$SCRIPT_PATH" "$@"

EXIT_CODE=$?
echo ""
echo "------------------------------------------"
if [ $EXIT_CODE -eq 0 ]; then
    echo "Done. 集合文件已生成到 ../05-out/ 目录。"
else
    echo "Error: 生成失败 (Exit Code: $EXIT_CODE)."
fi
echo ""
exit $EXIT_CODE
