(100000002, 1000001, '{{ ft1.code }}', 'http://localhost:9000/task/{{ module.domain }}/{{ module.code }}/f1_2.jpg', '{{ module.name }}1_{{ ft1.label }}.jpg', 0, NOW(), 1001, 2001),
(100000003, 1000002, '{{ ft0.code }}', 'http://localhost:9000/task/{{ module.domain }}/{{ module.code }}/f2_1.pdf', '{{ module.name }}2_{{ ft0.label }}.pdf', 0, NOW(), 1001, 2001),
(100000004, 1000002, '{{ ft1.code }}', 'http://localhost:9000/task/{{ module.domain }}/{{ module.code }}/f2_2.jpg', '{{ module.name }}2_{{ ft1.label }}.jpg', 0, NOW(), 1001, 2001),
