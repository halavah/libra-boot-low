<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back :title="form.id ? '编辑{{ module.name }}' : '新增{{ module.name }}'" @go-back="handleBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <el-form ref="formRef" :model="form" :rules="rules" label-width="auto" v-loading="loading">
          <el-row :gutter="20">

{% for field in fields %}{% if not field.generated %}
{% if field.type == 'input' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input v-model="form.{{ field.name }}" placeholder="请输入{{ field.label }}" clearable />
          </el-form-item>
          </el-col>
{% elif field.type == 'textarea' %}
          <el-col :span="24">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input v-model="form.{{ field.name }}" type="textarea" :rows="3" placeholder="请输入{{ field.label }}" />
          </el-form-item>
          </el-col>
{% elif field.type == 'number' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input-number v-model="form.{{ field.name }}" :min="0" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'decimal' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-input-number v-model="form.{{ field.name }}" :precision="2" :min="0" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="date" value-format="YYYY-MM-DD" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'datetime' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="datetime" value-format="YYYY-MM-DD HH:mm:ss" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date-year' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="year" value-format="YYYY" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'date-month' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-date-picker v-model="form.{{ field.name }}" type="month" value-format="YYYY-MM" style="width: 100%" />
          </el-form-item>
          </el-col>
{% elif field.type == 'select' %}
          <el-col :span="12">
            <el-form-item label="{{ field.label }}" prop="{{ field.name }}">
            <el-select v-model="form.{{ field.name }}" placeholder="请选择{{ field.label }}" clearable style="width: 100%">
{% for option in field.options %}
              <el-option label="{{ option.label }}" :value="{{ option.value }}" />
{% endfor %}
            </el-select>
          </el-form-item>
          </el-col>
{% endif %}
{% endif %}{% endfor %}
        
          </el-row>
</el-form>
      </el-card>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">附件</span></div>
        </template>
        <el-upload :http-request="handleUpload" :on-remove="handleRemove" :on-preview="handlePreview" :file-list="uiFileList" multiple>
          <el-button type="primary" plain>点击上传文件</el-button>
          <template #tip>
            <div class="el-upload__tip">{% if module.file_types and module.file_types | length > 0 %}支持上传{% for ft in module.file_types %}{{ ft.label }}{% if not loop.last %}、{% endif %}{% endfor %}等，{% endif %}单个文件不超过 50MB</div>
          </template>
        </el-upload>
      </el-card>

      <el-card class="mb-20">
        <el-button type="primary" :loading="submitting" @click="handleSubmit">确认</el-button>
        <el-button @click="handleBack">取消</el-button>
      </el-card>

      <div style="height: 150px"></div>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from "vue"
import { ElMessage } from "element-plus"
import api from "@/service/{{ module.domain }}/{{ module.code }}.js"

const props = defineProps({
  id: { type: String, default: "" }
})
const emit = defineEmits(["call-back-data"])

const formRef = ref(null)
const loading = ref(false)
const submitting = ref(false)
const uiFileList = ref([])
const uploadedFiles = ref([])
const is_uploadedFileList = ref(false)

const form = reactive({
  id: "",
{% for field in fields %}{% if not field.generated %}  {{ field.name }}: null,
{% endif %}{% endfor %}  fileList: []
})

const rules = {
{% for field in fields %}{% if field.required and not field.generated %}  {{ field.name }}: [{ required: true, message: "{% if field.type == 'select' %}请选择{% else %}请输入{% endif %}{{ field.label }}", trigger: "{% if field.type == 'select' %}change{% else %}blur{% endif %}" }],
{% endif %}{% endfor %}
}

// 日期字段标准化：兼容 number / ISO / 普通字符串 → 控件所需格式（字符串截取，不做时区换算）
const normalizeDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

// 获取附件列表
const getFileList = () => {
  if (!props.id) return
  api.fileList(props.id).then((res) => {
    uploadedFiles.value = res || []
    uiFileList.value = (res || []).map((f) => ({ name: f.fileName, url: f.fileUrl }))
  }).catch(() => {
    uploadedFiles.value = []
    uiFileList.value = []
  })
}

onMounted(() => {
  if (props.id) {
    loading.value = true
    api.getDetail(props.id).then((res) => {
      if (res) {
        Object.assign(form, res)
        form.id = props.id
{% for field in fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] %}        form.{{ field.name }} = normalizeDateField(form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}        if (form.fileList && form.fileList.length > 0) {
          uiFileList.value = form.fileList.map((f) => ({ name: f.fileName, url: f.fileUrl }))
        }
        getFileList()
      }
    }).finally(() => {
      loading.value = false
    })
  }
})

const handleUpload = (options) => {
  const formData = new FormData()
  formData.append("file", options.file)
  is_uploadedFileList.value = true
  api.upload(formData).then((res) => {
    if (res) {
      form.fileList.push({ fileName: res.fileName, fileUrl: res.fileUrl, fileType: "{% if module.file_types and module.file_types | length > 0 %}{{ module.file_types[0].code }}{% else %}annex{% endif %}" })
      uiFileList.value.push({ name: res.fileName, url: res.fileUrl })
      ElMessage.success("附件上传成功")
      options.onSuccess(res, options.file)
    }
  }).catch((err) => {
    ElMessage.error("上传失败")
    options.onError(err)
  }).finally(() => {
    is_uploadedFileList.value = false
  })
}

const handleRemove = (file) => {
  const targetUrl = file.url
  form.fileList = form.fileList.filter((f) => f.fileUrl !== targetUrl)
}

const handlePreview = (file) => {
  // el-upload 内部 file.url 在新上传时为 blob: URL，不是 MinIO URL
  // 从 uiFileList 按文件名查找真实 MinIO URL（兜底再用 file.url）
  const found = uiFileList.value.find(f => f.name === file.name)
  const url = (found && found.url) ? found.url : file.url
  if (url) window.open(url, '_blank')
}

const handleBack = () => {
  emit("call-back-data", 0)
}

const handleSubmit = () => {
  formRef.value.validate((valid) => {
    if (!valid) return
    // 等待附件上传完成
    if (is_uploadedFileList.value) {
      ElMessage.warning("附件正在上传中，请稍候...")
      return
    }
    submitting.value = true
    const action = form.id ? api.update : api.add
    action({ ...form }).then(() => {
      ElMessage.success(form.id ? "编辑成功" : "新增成功")
      // 重置上传状态
      is_uploadedFileList.value = false
      emit("call-back-data", 1)
    }).finally(() => {
      submitting.value = false
    })
  })
}
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
