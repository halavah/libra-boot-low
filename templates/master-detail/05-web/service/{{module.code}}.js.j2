/**
 * {{ module.name }} API 服务（主表 + 明细表合并）
 *
 * @author Libra Boot Low Generator
 * @since {{ generated_date }}
 */
import http from '@/common/utils/http'

const SVC = '/layer/v1/sys-service'
const GROUP_URL = `${SVC}/{{ module.domain }}/{{ group_code }}`

export default {
  // ==================== 主表（{{ master_module.name }}）====================

  /**
   * 主表-分页查询
   */
  getMasterList(params) {
    return http.get(`${GROUP_URL}/{{ master_module.code }}/list`, params)
  },

  /**
   * 主表-查询详情
   */
  getMasterDetail(id) {
    return http.get(`${GROUP_URL}/{{ master_module.code }}/detail`, { id })
  },

  /**
   * 主表-新增
   */
  addMaster(data) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/add`, data)
  },

  /**
   * 主表-修改
   */
  updateMaster(data) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/update`, data)
  },

  /**
   * 主表-删除（逻辑删除）
   */
  removeMaster(ids) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/remove`, ids)
  },

  /**
   * 主表-彻底删除（物理删除）
   */
  physicalRemoveMaster(ids) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/physical-remove`, ids)
  },

  /**
   * 主表-导出
   */
  exportMaster(params) {
    return http.export(`${GROUP_URL}/{{ master_module.code }}/export`, params)
  },
{% if module.master.has_batch_operations %}

  /**
   * 主表-批量删除
   */
  batchDeleteMaster(ids) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/batch-delete`, ids)
  },

  /**
   * 主表-批量彻底删除（物理删除）
   */
  batchPhysicalDeleteMaster(ids) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/batch-physical-delete`, ids)
  },

  /**
   * 主表-批量更新
   */
  batchUpdateMaster(data) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/batch-update`, data)
  },

  /**
   * 主表-批量状态切换
   */
  batchToggleMaster(data) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/batch-toggle`, data)
  },
{% endif %}

  // ==================== 明细表（{{ detail_module.name }}）====================

  /**
   * 明细表-分页查询
   */
  getDetailList(params) {
    return http.get(`${GROUP_URL}/{{ detail_module.code }}/list`, params)
  },

  /**
   * 明细表-查询详情
   */
  getDetailDetail(id) {
    return http.get(`${GROUP_URL}/{{ detail_module.code }}/detail`, { id })
  },

  /**
   * 明细表-新增
   */
  addDetail(data) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/add`, data)
  },

  /**
   * 明细表-修改
   */
  updateDetail(data) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/update`, data)
  },

  /**
   * 明细表-删除（逻辑删除）
   */
  removeDetail(ids) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/remove`, ids)
  },

  /**
   * 明细表-彻底删除（物理删除）
   */
  physicalRemoveDetail(ids) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/physical-remove`, ids)
  },

  /**
   * 明细表-导出
   */
  exportDetail(params) {
    return http.export(`${GROUP_URL}/{{ detail_module.code }}/export`, params)
  },
{% if module.detail.has_batch_operations %}

  /**
   * 明细表-批量删除
   */
  batchDeleteDetail(ids) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/batch-delete`, ids)
  },

  /**
   * 明细表-批量彻底删除（物理删除）
   */
  batchPhysicalDeleteDetail(ids) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/batch-physical-delete`, ids)
  },

  /**
   * 明细表-批量更新
   */
  batchUpdateDetail(data) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/batch-update`, data)
  },

  /**
   * 明细表-批量状态切换
   */
  batchToggleDetail(data) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/batch-toggle`, data)
  },
{% endif %}
{% if module.master.has_status_toggles %}

  /**
   * 主表状态切换
   */
  toggleMaster(data) {
    return http.post(`${GROUP_URL}/{{ master_module.code }}/toggle`, data)
  },
{% endif %}
{% if module.detail.has_status_toggles %}

  /**
   * 明细表状态切换
   */
  toggleDetail(data) {
    return http.post(`${GROUP_URL}/{{ detail_module.code }}/toggle`, data)
  }
{% endif %}
}
