## 4. 页面切换逻辑

```javascript
// index.vue
const state = reactive({
  isType: 1,  // 1:List 2:Add/Edit 3:Detail
  editId: ''
});

// 切换到新增/编辑
const topOperate = (val) => {
  if (val === 1) { state.editId = ''; state.isType = 2; }
};

// 行操作
const listOperate = (row, type) => {
  if (type === 1) { state.editId = row.id; state.isType = 3; }  // 详情
  if (type === 2) { state.editId = row.id; state.isType = 2; }  // 编辑
};

// 子组件回调
const listAddOrEdit = (val) => {
  state.isType = 1;
  if (val === 1) getList();  // 刷新列表
};
```
