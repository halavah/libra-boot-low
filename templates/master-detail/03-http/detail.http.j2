{%- set lb = '{{' -%}
{%- set rb = '}}' -%}
# 硬编码说明: detail_url 中的 localhost:9072 为本地开发服务地址，按需修改
# 明细表（{{ detail_module.name }}）接口 — CRUD + 导出
@detail_url = http://localhost:9072{{ detail_module.api_path }}
@test_master_id = 1000001
@test_detail_id = 2000001

### ============================================================
### 1. 分页查询（基础）
### ============================================================
GET {{ lb }}detail_url{{ rb }}/list?current=1&size=10
Content-Type: application/json

### 2. 分页查询（带条件，按主表ID过滤）
GET {{ lb }}detail_url{{ rb }}/list?current=1&size=10&{{ detail_module.master_fk }}={{ lb }}test_master_id{{ rb }}{% for field in detail_fields %}{% if field.filterable %}{% if field.type == 'input' or field.type == 'textarea' %}&{{ field.name }}={{ field.label }}1{% elif field.type == 'select' and field.options %}&{{ field.name }}={{ field.options[0].value }}{% elif field.type == 'date-year' %}&{{ field.name }}=2025{% elif field.type == 'date-month' %}&{{ field.name }}=2025-01{% elif field.type == 'number' %}&{{ field.name }}=10{% elif field.type == 'date' or field.type == 'datetime' %}&{{ field.name }}Begin=2025-01-01&{{ field.name }}End=2025-12-31{% endif %}{% endif %}{% endfor %}
Content-Type: application/json

### ============================================================
### 3. 查询详情
### ============================================================
GET {{ lb }}detail_url{{ rb }}/detail?id={{ lb }}test_detail_id{{ rb }}
Content-Type: application/json

### ============================================================
### 4. 新增
### ============================================================
POST {{ lb }}detail_url{{ rb }}/add
Content-Type: application/json

{
    "{{ detail_module.master_fk }}": "{{ lb }}test_master_id{{ rb }}",
{% for field in detail_fields %}
{% if field.type == 'input' or field.type == 'textarea' %}
    "{{ field.name }}": "{{ field.label }}测试",
{% elif field.type == 'select' and field.options %}
    "{{ field.name }}": {{ field.options[0].value }},
{% elif field.type == 'date-year' %}
    "{{ field.name }}": 2025,
{% elif field.type == 'date-month' %}
    "{{ field.name }}": "2025-06",
{% elif field.type == 'number' %}
    "{{ field.name }}": 100,
{% elif field.type == 'decimal' %}
    "{{ field.name }}": 99.99,
{% elif field.type == 'date' %}
    "{{ field.name }}": "2025-06-01",
{% elif field.type == 'datetime' %}
    "{{ field.name }}": "2025-06-01 10:00:00",
{% else %}
    "{{ field.name }}": null,
{% endif %}
{% endfor %}
    "_comment": "{{ detail_module.name }}新增"
}

### ============================================================
### 5. 修改
### ============================================================
POST {{ lb }}detail_url{{ rb }}/update
Content-Type: application/json

{
    "id": "{{ lb }}test_detail_id{{ rb }}",
    "{{ detail_module.master_fk }}": "{{ lb }}test_master_id{{ rb }}",
{% for field in detail_fields %}
{% if field.type == 'input' or field.type == 'textarea' %}
    "{{ field.name }}": "{{ field.label }}已修改",
{% elif field.type == 'select' and field.options %}
    "{{ field.name }}": {{ field.options[0].value }},
{% elif field.type == 'date-year' %}
    "{{ field.name }}": 2025,
{% elif field.type == 'date-month' %}
    "{{ field.name }}": "2025-09",
{% elif field.type == 'number' %}
    "{{ field.name }}": 200,
{% elif field.type == 'decimal' %}
    "{{ field.name }}": 88.88,
{% elif field.type == 'date' %}
    "{{ field.name }}": "2025-09-01",
{% elif field.type == 'datetime' %}
    "{{ field.name }}": "2025-09-01 14:00:00",
{% else %}
    "{{ field.name }}": null,
{% endif %}
{% endfor %}
    "_comment": "{{ detail_module.name }}修改"
}

### ============================================================
### 6. 删除
### ============================================================
POST {{ lb }}detail_url{{ rb }}/remove
Content-Type: application/json

["{{ lb }}test_detail_id{{ rb }}"]

### ============================================================
### 7. 导出
### ============================================================
{% set export_params = [] %}
{% for field in detail_fields %}{% if field.filterable %}{% if field.type == 'input' or field.type == 'textarea' %}{% set _ = export_params.append(field.name + '=' + field.label + '1') %}{% elif field.type == 'select' and field.options %}{% set _ = export_params.append(field.name + '=' + (field.options[0].value | string)) %}{% elif field.type == 'date-year' %}{% set _ = export_params.append(field.name + '=2025') %}{% elif field.type == 'date-month' %}{% set _ = export_params.append(field.name + '=2025-01') %}{% endif %}{% endif %}{% endfor %}
GET {{ lb }}detail_url{{ rb }}/export{% if export_params %}?{{ export_params | join('&') }}{% endif %}
Content-Type: application/json

### ============================================================
### 8. 彻底删除（物理删除）
### ============================================================
POST {{ lb }}detail_url{{ rb }}/physical-remove
Content-Type: application/json

["{{ lb }}test_detail_id{{ rb }}"]

{% if module.has_batch_operations %}
### ============================================================
### 9. 批量删除（逻辑删除）
### ============================================================
POST {{ lb }}detail_url{{ rb }}/batch-delete
Content-Type: application/json

[2000001, 2000002, 2000003]

### ============================================================
### 10. 批量彻底删除（物理删除）
### ============================================================
POST {{ lb }}detail_url{{ rb }}/batch-physical-delete
Content-Type: application/json

[2000001, 2000002]

### ============================================================
### 11. 批量更新
### ============================================================
POST {{ lb }}detail_url{{ rb }}/batch-update
Content-Type: application/json

{
  "ids": [2000001, 2000002],
  "data": {
{% for f in detail_module.batch_operations["update"]["fields"] %}
    "{{ f.name }}": {% if f.type == 'select' %}1{% elif f.type == 'date' %}"2025-01-01"{% else %}"示例值"{% endif %}{% if not loop.last %},{% endif %}

{% endfor %}
  }
}
{% endif %}
