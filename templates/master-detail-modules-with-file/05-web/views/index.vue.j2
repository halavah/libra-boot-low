{% set ns2 = namespace(has_any_dm_batch_update=false) %}{% for dm in detail_modules %}{% if dm.has_batch_operations and dm.batch_operations["update"]["enabled"] %}{% set ns2.has_any_dm_batch_update = true %}{% endif %}{% endfor %}
{% if ns2.has_any_dm_batch_update %}
// 明细批量更新（通用弹窗模式，通过 dmIndex 区分）
const openDetailBatchUpdateDialog = (dmIndex) => {
  if (dmSelectIds.value[dmIndex].length === 0) {
    ElMessage.warning('请先选择要操作的记录')
    return
  }
  dmBatchUpdateVisible.value[dmIndex] = true
}

const resetDetailBatchUpdateForm = (dmIndex) => {
  const form = dmBatchUpdateForm.value[dmIndex]
  if (form) {
    Object.keys(form).forEach(key => { form[key] = null })
  }
}

const submitDetailBatchUpdate = (dmIndex) => {
  const form = dmBatchUpdateForm.value[dmIndex]
  const data = {}
  if (form) {
    Object.keys(form).forEach(key => {
      if (form[key] !== null && form[key] !== '') {
        data[key] = form[key]
      }
    })
  }
  if (Object.keys(data).length === 0) {
    ElMessage.warning('请至少填写一个字段')
    return
  }
  dmBatchUpdateLoading.value[dmIndex] = true
  DM_APIS[dmIndex].batchUpdate({ ids: dmSelectIds.value[dmIndex], data }).then(() => {
    ElMessage.success('批量更新成功')
    dmBatchUpdateVisible.value[dmIndex] = false
    resetDetailBatchUpdateForm(dmIndex)
    dmSelectIds.value[dmIndex] = []
      if (dmTableRefs[dmIndex]) dmTableRefs[dmIndex].clearSelection()
    getDetailList(dmIndex)
  }).finally(() => {
    dmBatchUpdateLoading.value[dmIndex] = false
  })
}
{% endif %}
