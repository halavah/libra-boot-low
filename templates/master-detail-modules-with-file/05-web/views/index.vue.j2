<template>
  <!-- ==================== 主表列表 ==================== -->
  <div v-if="isType == 1" class="container">
    <G-form-search :form-data="masterFormData" :form-data-info="masterFormDataInfo" @call-back-data="handleMasterSearch"></G-form-search>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="display: flex; gap: 10px;">
        <el-button type="primary" icon="Plus" @click="masterTopOperate(1)">新增</el-button>
{% if module.master.has_batch_operations and module.master.batch_operations.delete.enabled %}
        <el-button type="primary" icon="Delete" plain :disabled="masterSelectIds.length === 0" @click="handleMasterBatchDelete">批量删除</el-button>
{% endif %}
{% if module.master.has_batch_operations and module.master.batch_operations.physical_delete.enabled %}
        <el-button type="primary" icon="DeleteFilled" plain :disabled="masterSelectIds.length === 0" @click="handleMasterBatchPhysicalDelete">批量彻底删除</el-button>
{% endif %}
{% if module.master.has_batch_operations and module.master.batch_operations["update"]["enabled"] %}
        <el-button type="primary" plain :disabled="masterSelectIds.length === 0" @click="openMasterBatchUpdateDialog">批量更新</el-button>
{% endif %}
        <el-button type="primary" icon="Download" plain @click="handleMasterExport">导出</el-button>
      </div>
      <G-operation :show-left="false" :table-header="{ originHeader: masterOriginHeader, tableHeader: masterTableHeader }" @call-back-data="masterTopOperate"></G-operation>
    </div>

    <G-table
      ref="masterTableRef"
      :loading="masterLoading"
      :table-data="masterTableData"
      :table-header="masterTableHeader"
      :table-info="{ customOperate: true{% if module.master.has_batch_operations %}, isSelect: true, reserveSelection: true, rowKey: 'id'{% endif %} }"
      :page-no="masterPage.current"
      :page-size="masterPage.size"
      @call-back-data="masterListOperate"
{% if module.master.has_batch_operations %}
      @selection-change="handleMasterSelectionChange"
{% endif %}
    >
      {% for field in master_fields %}{% if field.type == 'select' and field.options %}
      <template #{{ field.name }}="{ row }">
{% for opt in field.options %}        <el-tag v-{% if loop.index0 == 0 %}if{% else %}else-if{% endif %}="row.{{ field.name }} == '{{ opt.value }}'" type="{% if loop.index0 == 0 %}info{% elif loop.index0 == 1 %}primary{% elif loop.index0 == 2 %}success{% elif loop.index0 == 3 %}warning{% else %}danger{% endif %}">{{ opt.label }}</el-tag>
{% endfor %}        <span v-else>--</span>
      </template>
{% endif %}{% endfor %}
      <template #operateColumn="{ row }">
{% if module.master.has_status_toggles %}
{% for toggle in module.master.status_toggles %}
        <!-- {{ toggle['label'] }} 切换按钮 -->
        <el-button v-if="row.{{ toggle['field'] }} == 0" link type="{{ toggle['colors']['1'] }}" @click="handleMasterToggle(row, '{{ toggle['field'] }}', 1)">{{ toggle['values']['1'] }}</el-button>
        <el-button v-else link type="{{ toggle['colors']['0'] }}" @click="handleMasterToggle(row, '{{ toggle['field'] }}', 0)">{{ toggle['values']['0'] }}</el-button>
{% endfor %}
{% endif %}
        <el-button link type="primary" @click="masterListOperate(row, 1)">详情</el-button>
        <el-button link type="primary" @click="masterListOperate(row, 2)">编辑</el-button>
        {% for dm in detail_modules %}
        <el-button link type="primary" @click="goToDetail(row, {{ loop.index0 }})">{{ dm.name }}</el-button>
        {% endfor %}
{% if module.master.single_operations.delete.enabled %}
        <el-button link type="primary" @click="handleMasterDelete(row)">删除</el-button>
{% endif %}
{% if module.master.single_operations.physical_delete.enabled %}
        <el-button link type="primary" @click="handleMasterPhysicalRemove(row)">彻底删除</el-button>
{% endif %}
      </template>
    </G-table>

    <G-pagination v-model:page-no="masterPage.current" v-model:page-size="masterPage.size" :total="masterTotal" @get-list="getMasterList" />
{% if module.master.has_batch_operations and module.master.batch_operations["update"]["enabled"] %}

    <!-- 主表批量更新弹窗 -->
    <el-dialog title="批量更新" v-model="masterBatchUpdateVisible" width="500px" @close="resetMasterBatchUpdateForm">
      <el-form :model="masterBatchUpdateForm" label-width="auto">
{% for f in module.master.batch_operations["update"]["fields"] %}
        <el-form-item label="{{ f.label }}"{% if f.required %} required{% endif %}>
{% if f.type == 'select' %}
          <el-select v-model="masterBatchUpdateForm.{{ f.name }}" placeholder="请选择" clearable style="width: 100%">
{% for opt in f.options %}
            <el-option label="{{ opt.label }}" :value="{{ opt.value }}" />
{% endfor %}
          </el-select>
{% elif f.type == 'date' %}
          <el-date-picker v-model="masterBatchUpdateForm.{{ f.name }}" type="date" value-format="YYYY-MM-DD" placeholder="请选择日期" style="width: 100%" />
{% elif f.type == 'textarea' %}
          <el-input v-model="masterBatchUpdateForm.{{ f.name }}" type="textarea" :rows="3" placeholder="请输入{{ f.label }}" />
{% else %}
          <el-input v-model="masterBatchUpdateForm.{{ f.name }}" placeholder="请输入{{ f.label }}" />
{% endif %}
        </el-form-item>
{% endfor %}
      </el-form>
      <template #footer>
        <el-button @click="masterBatchUpdateVisible = false">取消</el-button>
        <el-button type="primary" :loading="masterBatchUpdateLoading" @click="submitMasterBatchUpdate">确认</el-button>
      </template>
    </el-dialog>
{% endif %}

    <el-button data-testid="nav-{{ module.code }}-master-add-or-edit" style="display:none" @click="masterTopOperate(1)" />
  </div>

  <!-- ==================== 主表新增/编辑 ==================== -->
  <{{ master_module.code_pascal }}AddOrEdit
    v-else-if="isType == 2"
    :id="masterId"
    @call-back-data="masterAddOrEditCallback"
  />

  <!-- ==================== 主表详情 ==================== -->
  <{{ master_module.code_pascal }}Detail
    v-else-if="isType == 3"
    :id="masterId"
    @call-back-data="masterDetailCallback"
  />

  {% for dm in detail_modules %}
  {% set base = 4 + loop.index0 * 3 %}
  <!-- ==================== 明细{{ loop.index }}列表（{{ dm.name }}） isType={{ base }} ==================== -->
  <div v-else-if="isType == {{ base }}" class="container">
    <div style="display: flex; align-items: center; margin-bottom: 20px;">
      <el-button type="primary" icon="ArrowLeft" @click="goBackToMaster">返回</el-button>
      <span style="font-size: 16px; font-weight: bold; margin-left: 12px;">{% raw %}{{ masterName }}{% endraw %} - {{ dm.name }}</span>
    </div>

    <G-form-search :form-data="dmFormData[{{ loop.index0 }}]" :form-data-info="dm{{ loop.index0 }}FormDataInfo" @call-back-data="(v) => handleDetailSearch({{ loop.index0 }}, v)"></G-form-search>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="display: flex; gap: 10px;">
        <el-button type="primary" icon="Plus" @click="detailTopOperate({{ loop.index0 }}, 1)">新增</el-button>
{% if dm.has_batch_operations and dm.batch_operations.delete.enabled %}
        <el-button type="primary" icon="Delete" plain :disabled="dmSelectIds[{{ loop.index0 }}].length === 0" @click="handleDetailBatchDelete({{ loop.index0 }})">批量删除</el-button>
{% endif %}
{% if dm.has_batch_operations and dm.batch_operations.physical_delete.enabled %}
        <el-button type="primary" icon="DeleteFilled" plain :disabled="dmSelectIds[{{ loop.index0 }}].length === 0" @click="handleDetailBatchPhysicalDelete({{ loop.index0 }})">批量彻底删除</el-button>
{% endif %}
{% if dm.has_batch_operations and dm.batch_operations["update"]["enabled"] %}
        <el-button type="primary" plain :disabled="dmSelectIds[{{ loop.index0 }}].length === 0" @click="openDetailBatchUpdateDialog({{ loop.index0 }})">批量更新</el-button>
{% endif %}
      </div>
      <G-operation :show-left="false" :table-header="{ originHeader: dm{{ loop.index0 }}OriginHeader, tableHeader: dm{{ loop.index0 }}TableHeader }" @call-back-data="(v, a) => detailTopOperate({{ loop.index0 }}, v, a)"></G-operation>
    </div>

    <G-table
      :ref="el => { if (el) dmTableRefs[{{ loop.index0 }}] = el }"
      :loading="dmLoading[{{ loop.index0 }}]"
      :table-data="dmTableData[{{ loop.index0 }}]"
      :table-header="dm{{ loop.index0 }}TableHeader"
      :table-info="{ customOperate: true{% if dm.has_batch_operations %}, isSelect: true, reserveSelection: true, rowKey: 'id'{% endif %} }"
      :page-no="dmPage[{{ loop.index0 }}].current"
      :page-size="dmPage[{{ loop.index0 }}].size"
      @call-back-data="(row, type) => detailListOperate({{ loop.index0 }}, row, type)"
{% if dm.has_batch_operations %}
      @selection-change="(selection) => handleDetailSelectionChange({{ loop.index0 }}, selection)"
{% endif %}
    >
      {% for field in dm.fields %}{% if field.type == 'select' and field.options %}
      <template #{{ field.name }}="{ row }">
{% for opt in field.options %}        <el-tag v-{% if loop.index0 == 0 %}if{% else %}else-if{% endif %}="row.{{ field.name }} == '{{ opt.value }}'" type="{% if loop.index0 == 0 %}info{% elif loop.index0 == 1 %}primary{% elif loop.index0 == 2 %}success{% elif loop.index0 == 3 %}warning{% else %}danger{% endif %}">{{ opt.label }}</el-tag>
{% endfor %}        <span v-else>--</span>
      </template>
{% endif %}{% endfor %}
      <template #operateColumn="{ row }">
{% if dm.has_status_toggles %}
{% for toggle in dm.status_toggles %}
        <!-- {{ toggle['label'] }} 切换按钮 -->
        <el-button v-if="row.{{ toggle['field'] }} == 0" link type="{{ toggle['colors']['1'] }}" @click="handleDetailToggle{{ loop.index0 }}(row, '{{ toggle['field'] }}', 1)">{{ toggle['values']['1'] }}</el-button>
        <el-button v-else link type="{{ toggle['colors']['0'] }}" @click="handleDetailToggle{{ loop.index0 }}(row, '{{ toggle['field'] }}', 0)">{{ toggle['values']['0'] }}</el-button>
{% endfor %}
{% endif %}
        <el-button link type="primary" @click="detailListOperate({{ loop.index0 }}, row, 1)">详情</el-button>
        <el-button link type="primary" @click="detailListOperate({{ loop.index0 }}, row, 2)">编辑</el-button>
{% if dm.single_operations is defined and dm.single_operations.delete.enabled %}
        <el-button link type="primary" @click="handleDetailDelete({{ loop.index0 }}, row)">删除</el-button>
{% endif %}
{% if dm.single_operations is defined and dm.single_operations.physical_delete.enabled %}
        <el-button link type="primary" @click="handleDetailPhysicalRemove({{ loop.index0 }}, row)">彻底删除</el-button>
{% endif %}
      </template>
    </G-table>

    <G-pagination v-model:page-no="dmPage[{{ loop.index0 }}].current" v-model:page-size="dmPage[{{ loop.index0 }}].size" :total="dmTotal[{{ loop.index0 }}]" @get-list="() => getDetailList({{ loop.index0 }})" />
{% if dm.has_batch_operations and dm.batch_operations["update"]["enabled"] %}

    <!-- 明细{{ loop.index }}批量更新弹窗 -->
    <el-dialog title="批量更新" v-model="dmBatchUpdateVisible[{{ loop.index0 }}]" width="500px" @close="resetDetailBatchUpdateForm({{ loop.index0 }})">
      <el-form :model="dmBatchUpdateForm[{{ loop.index0 }}]" label-width="auto">
{% for f in dm.batch_operations["update"]["fields"] %}
        <el-form-item label="{{ f.label }}"{% if f.required %} required{% endif %}>
{% if f.type == 'select' %}
          <el-select v-model="dmBatchUpdateForm[{{ loop.index0 }}].{{ f.name }}" placeholder="请选择" clearable style="width: 100%">
{% for opt in f.options %}
            <el-option label="{{ opt.label }}" :value="{{ opt.value }}" />
{% endfor %}
          </el-select>
{% elif f.type == 'date' %}
          <el-date-picker v-model="dmBatchUpdateForm[{{ loop.index0 }}].{{ f.name }}" type="date" value-format="YYYY-MM-DD" placeholder="请选择日期" style="width: 100%" />
{% elif f.type == 'textarea' %}
          <el-input v-model="dmBatchUpdateForm[{{ loop.index0 }}].{{ f.name }}" type="textarea" :rows="3" placeholder="请输入{{ f.label }}" />
{% else %}
          <el-input v-model="dmBatchUpdateForm[{{ loop.index0 }}].{{ f.name }}" placeholder="请输入{{ f.label }}" />
{% endif %}
        </el-form-item>
{% endfor %}
      </el-form>
      <template #footer>
        <el-button @click="dmBatchUpdateVisible[{{ loop.index0 }}] = false">取消</el-button>
        <el-button type="primary" :loading="dmBatchUpdateLoading[{{ loop.index0 }}]" @click="submitDetailBatchUpdate({{ loop.index0 }})">确认</el-button>
      </template>
    </el-dialog>
{% endif %}

    <el-button data-testid="nav-{{ module.code }}-{{ dm.code }}-add-or-edit" style="display:none" @click="detailTopOperate({{ loop.index0 }}, 1)" />
  </div>

  <!-- ==================== 明细{{ loop.index }}新增/编辑（{{ dm.name }}） isType={{ base + 1 }} ==================== -->
  <{{ module.code_pascal }}{{ dm.code_pascal }}AddOrEdit
    v-else-if="isType == {{ base + 1 }}"
    :id="dmId[{{ loop.index0 }}]"
    :{{ master_module.code }}-id="masterId"
    @call-back-data="(v) => detailAddOrEditCallback({{ loop.index0 }}, v)"
  />

  <!-- ==================== 明细{{ loop.index }}详情（{{ dm.name }}） isType={{ base + 2 }} ==================== -->
  <{{ module.code_pascal }}{{ dm.code_pascal }}Detail
    v-else-if="isType == {{ base + 2 }}"
    :id="dmId[{{ loop.index0 }}]"
    @call-back-data="() => detailDetailCallback({{ loop.index0 }})"
  />
  {% endfor %}
</template>

<script setup>
import { reactive, toRefs, onMounted, ref } from "vue"
import { ElMessage, ElMessageBox } from "element-plus"
import api from "@/service/{{ module.domain }}/{{ group_code }}.js"
import fileExport from '@/common/utils/fileExport'
import {{ master_module.code_pascal }}AddOrEdit from "./{{ module.code }}-{{ master_module.code }}-add-or-edit.vue"
import {{ master_module.code_pascal }}Detail from "./{{ module.code }}-{{ master_module.code }}-detail.vue"
{% for dm in detail_modules %}
import {{ module.code_pascal }}{{ dm.code_pascal }}AddOrEdit from "./{{ module.code }}-{{ dm.code }}-add-or-edit.vue"
import {{ module.code_pascal }}{{ dm.code_pascal }}Detail from "./{{ module.code }}-{{ dm.code }}-detail.vue"
{% endfor %}

// ==================== 明细 API 方法映射（按下标路由） ====================
const DM_APIS = [
{% for dm in detail_modules %}
  {
    getList: (params) => api.get{{ dm.code_pascal }}List(params),
    getDetail: (id) => api.get{{ dm.code_pascal }}Detail(id),
    add: (data) => api.add{{ dm.code_pascal }}(data),
    update: (data) => api.update{{ dm.code_pascal }}(data),
    remove: (ids) => api.remove{{ dm.code_pascal }}(ids),
    physicalRemove: (ids) => api.physicalRemove{{ dm.code_pascal }}(ids),
    exportData: (params) => api.export{{ dm.code_pascal }}(params){% if dm.has_status_toggles %},
    toggle: (data) => api.toggle{{ dm.code_pascal }}(data){% endif %}{% if dm.has_batch_operations %},
    batchDelete: (ids) => api.batchDelete{{ dm.code_pascal }}(ids),
    batchPhysicalDelete: (ids) => api.batchPhysicalDelete{{ dm.code_pascal }}(ids),
    batchUpdate: (data) => api.batchUpdate{{ dm.code_pascal }}(data),
    batchToggle: (data) => api.batchToggle{{ dm.code_pascal }}(data){% endif %}
  }{% if not loop.last %},{% endif %}
{% endfor %}
]

// ==================== 主表状态 ====================

const state = reactive({
  isType: 1,
  masterId: "",
  masterName: "",
  masterSelectIds: [],
  masterTotal: 0,
  masterPage: { current: 1, size: 10 },
  masterFormData: {
{% for field in master_fields %}{% if field.type == 'date' or field.type == 'datetime' %}    {{ field.name }}: [],
{% else %}    {{ field.name }}: '',
{% endif %}{% endfor %}  },
  masterOriginHeader: [
{% for field in master_fields %}{% if not field.generated %}    { label: "{{ field.label }}", prop: "{{ field.name }}"{% if field.type == 'select' and field.options %}, type: "slot"{% endif %} },
{% endif %}{% endfor %}    { label: "创建时间", prop: "createTime" },
  ],
  masterTableHeader: [],
})

const masterTableData = ref([])
const masterLoading = ref(false)

const {
  isType, masterId, masterName, masterSelectIds, masterTotal, masterPage,
  masterFormData, masterOriginHeader, masterTableHeader
} = toRefs(state)
const masterTableRef = ref(null)
const dmTableRefs = reactive([])

const masterFormDataInfo = [
{% for field in master_fields %}{% if field.type == 'select' %}    { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'select', span: 4{% if field.options %}, options: {{ field.options_json }}{% endif %} },
{% elif field.type == 'date' or field.type == 'datetime' %}    { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'date', span: 8, dateInfo: { type: 'daterange', format: 'YYYY-MM-DD', vFormat: 'YYYY-MM-DD' } },
{% elif field.type == 'date-year' %}    { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'input', span: 4 },
{% else %}    { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'input', span: 6 },
{% endif %}{% endfor %}]

// ==================== 各明细表状态（按下标索引） ====================
{% for dm in detail_modules %}
// DM{{ loop.index0 }}: {{ dm.name }}
const dm{{ loop.index0 }}OriginHeader = [
{% for field in dm.fields %}{% if not field.generated %}  { label: "{{ field.label }}", prop: "{{ field.name }}"{% if field.type == 'select' and field.options %}, type: "slot"{% endif %} },
{% endif %}{% endfor %}  { label: "创建时间", prop: "createTime" },
]
const dm{{ loop.index0 }}TableHeader = ref([...dm{{ loop.index0 }}OriginHeader])
const dm{{ loop.index0 }}FormDataInfo = [
{% for field in dm.fields %}{% if field.filterable %}{% if field.type == 'select' %}  { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'select', span: 4{% if field.options %}, options: {{ field.options_json }}{% endif %} },
{% elif field.type == 'date' or field.type == 'datetime' %}  { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'date', span: 8, dateInfo: { type: 'daterange', format: 'YYYY-MM-DD', vFormat: 'YYYY-MM-DD' } },
{% elif field.type == 'date-year' %}  { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'input', span: 4 },
{% else %}  { label: '{{ field.label }}', prop: '{{ field.name }}', type: 'input', span: 6 },
{% endif %}{% endif %}{% endfor %}]
{% endfor %}

// 多明细表共享数组（通过 dm_index 路由）
const dmFormData = ref([
{% for dm in detail_modules %}  { {{ master_module.code }}Id: ""{% for field in dm.fields %}, {{ field.name }}: {% if field.type == 'date' or field.type == 'datetime' %}[]{% else %}''{% endif %}{% endfor %} },
{% endfor %}])
const dmPage = ref([{% for dm in detail_modules %}{ current: 1, size: 10 }{% if not loop.last %}, {% endif %}{% endfor %}])
const dmTotal = ref([{% for dm in detail_modules %}0{% if not loop.last %}, {% endif %}{% endfor %}])
const dmId = ref([{% for dm in detail_modules %}""{% if not loop.last %}, {% endif %}{% endfor %}])
const dmSelectIds = ref([{% for dm in detail_modules %}[]{% if not loop.last %}, {% endif %}{% endfor %}])
const dmTableData = ref([{% for dm in detail_modules %}[]{% if not loop.last %}, {% endif %}{% endfor %}])
const dmLoading = ref([{% for dm in detail_modules %}false{% if not loop.last %}, {% endif %}{% endfor %}])
{% set ns = namespace(has_any_dm_batch_update=false) %}
{% for dm in detail_modules %}{% if dm.has_batch_operations and dm.batch_operations["update"]["enabled"] %}{% set ns.has_any_dm_batch_update = true %}{% endif %}{% endfor %}
{% if ns.has_any_dm_batch_update %}
const dmBatchUpdateVisible = ref([{% for d in detail_modules %}false{% if not loop.last %}, {% endif %}{% endfor %}])
const dmBatchUpdateLoading = ref([{% for d in detail_modules %}false{% if not loop.last %}, {% endif %}{% endfor %}])
const dmBatchUpdateForm = ref([
{% for d in detail_modules %}  {% if d.has_batch_operations and d.batch_operations["update"]["enabled"] %}{ {% for f in d.batch_operations["update"]["fields"] %}{{ f.name }}: null{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}{}{% endif %}{% if not loop.last %},{% endif %}
{% endfor %}])
{% endif %}

onMounted(() => {
  state.masterTableHeader = state.masterOriginHeader
  getMasterList()
})

// ==================== 主表操作 ====================

const getMasterList = () => {
  masterLoading.value = true
  const params = {
    ...state.masterFormData,
    current: state.masterPage.current,
    size: state.masterPage.size
  }
{% for field in master_fields %}{% if field.type == 'date' or field.type == 'datetime' %}
  if (state.masterFormData.{{ field.name }} && state.masterFormData.{{ field.name }}.length === 2) {
    params.{{ field.name }}Begin = state.masterFormData.{{ field.name }}[0]
    params.{{ field.name }}End = state.masterFormData.{{ field.name }}[1]
    delete params.{{ field.name }}
  }
{% endif %}{% endfor %}
  api.getMasterList(params).then((res) => {
    masterTableData.value = res.records || []
    state.masterTotal = res.total || 0
  }).finally(() => { masterLoading.value = false })
}

const handleMasterSearch = () => {
  state.masterPage.current = 1
  getMasterList()
}

const masterTopOperate = (val, arg) => {
  if (val == 1) {
    state.masterId = ""
    state.isType = 2
  } else if (val == 7) {
    getMasterList()
  } else if (val == 8) {
    state.masterTableHeader = arg
  }
}

const masterListOperate = (row, type) => {
  if (type == 1) {
    state.masterId = row.id
    state.isType = 3
  } else if (type == 2) {
    state.masterId = row.id
    state.isType = 2
  }
}

const masterAddOrEditCallback = (val) => {
  state.isType = 1
  if (val === 1) getMasterList()
}

const masterDetailCallback = () => { state.isType = 1 }

const handleMasterDelete = (row) => {
  ElMessageBox.confirm("确定删除该记录吗？关联的明细数据也会被删除！", "提示", { type: "warning" }).then(() => {
    api.removeMaster([row.id]).then(() => {
      ElMessage.success("删除成功")
      getMasterList()
    })
  })
}

const handleMasterPhysicalRemove = (row) => {
  ElMessageBox.confirm("确定彻底删除该记录吗？此操作不可恢复，关联的明细数据也会被删除！", "警告", { type: "warning" }).then(() => {
    api.physicalRemoveMaster([row.id]).then(() => {
      ElMessage.success("彻底删除成功")
      getMasterList()
    })
  })
}

const handleMasterExport = () => {
  const params = { ...state.masterFormData }
{% for field in master_fields %}{% if field.type == 'date' or field.type == 'datetime' %}
  if (state.masterFormData.{{ field.name }} && state.masterFormData.{{ field.name }}.length === 2) {
    params.{{ field.name }}Begin = state.masterFormData.{{ field.name }}[0]
    params.{{ field.name }}End = state.masterFormData.{{ field.name }}[1]
    delete params.{{ field.name }}
  }
{% endif %}{% endfor %}
  api.exportMaster(params).then((res) => {
    fileExport(res.data, "xlsx", "{{ master_module.name }}列表")
  })
}

// ==================== 进入明细（由明细下标路由） ====================

const goToDetail = (row, dmIndex) => {
  state.masterId = row.id
  state.masterName = row.{{ master_display_field | default('name') }} || row.id
  // 重置目标明细的 formData 和分页
  dmFormData.value[dmIndex] = { ...dmFormData.value[dmIndex], {{ master_module.code }}Id: row.id }
  dmPage.value[dmIndex] = { current: 1, size: 10 }
  state.isType = 4 + dmIndex * 3
  getDetailList(dmIndex)
}

// ==================== 通用明细操作（dmIndex 路由） ====================

const getDetailList = (dmIndex) => {
  dmLoading.value[dmIndex] = true
  const params = {
    ...dmFormData.value[dmIndex],
    current: dmPage.value[dmIndex].current,
    size: dmPage.value[dmIndex].size
  }
  DM_APIS[dmIndex].getList(params).then((res) => {
    dmTableData.value[dmIndex] = res.records || []
    dmTotal.value[dmIndex] = res.total || 0
  }).finally(() => { dmLoading.value[dmIndex] = false })
}

const handleDetailSearch = (dmIndex) => {
  dmPage.value[dmIndex].current = 1
  getDetailList(dmIndex)
}

const detailTopOperate = (dmIndex, val, arg) => {
  if (val == 1) {
    dmId.value[dmIndex] = ""
    state.isType = 4 + dmIndex * 3 + 1
  } else if (val == 7) {
    getDetailList(dmIndex)
  } else if (val == 8) {
    // tableHeader update handled by G-operation
  }
}

const detailListOperate = (dmIndex, row, type) => {
  if (type == 1) {
    dmId.value[dmIndex] = row.id
    state.isType = 4 + dmIndex * 3 + 2
  } else if (type == 2) {
    dmId.value[dmIndex] = row.id
    state.isType = 4 + dmIndex * 3 + 1
  }
}

const detailAddOrEditCallback = (dmIndex, val) => {
  state.isType = 4 + dmIndex * 3
  if (val === 1) getDetailList(dmIndex)
}

const detailDetailCallback = (dmIndex) => {
  state.isType = 4 + dmIndex * 3
}

const handleDetailDelete = (dmIndex, row) => {
  ElMessageBox.confirm("确定删除该记录吗？", "提示", { type: "warning" }).then(() => {
    DM_APIS[dmIndex].remove([row.id]).then(() => {
      ElMessage.success("删除成功")
      getDetailList(dmIndex)
    })
  })
}

const handleDetailPhysicalRemove = (dmIndex, row) => {
  ElMessageBox.confirm("确定彻底删除该记录吗？此操作不可恢复！", "警告", { type: "warning" }).then(() => {
    DM_APIS[dmIndex].physicalRemove([row.id]).then(() => {
      ElMessage.success("彻底删除成功")
      getDetailList(dmIndex)
    })
  })
}

const goBackToMaster = () => {
  state.isType = 1
}
{% if module.master.has_status_toggles %}

// 主表状态切换配置
const masterStatusToggles = {{ module.master.status_toggles | tojson }}

// 主表状态切换
const handleMasterToggle = (row, field, value) => {
  const toggle = masterStatusToggles.find(t => t.field === field)
  const valueLabel = toggle.values[value] || value
  ElMessageBox.confirm(`确定要${valueLabel}吗？`, '提示', { type: 'warning' }).then(() => {
    api.toggleMaster({ id: row.id, field, value }).then(() => {
      ElMessage.success('操作成功')
      getMasterList()
    })
  })
}
{% endif %}
{% for dm in detail_modules %}
{% if dm.has_status_toggles %}

// 明细{{ loop.index }}状态切换配置
const dm{{ loop.index0 }}StatusToggles = {{ dm.status_toggles | tojson }}

// 明细{{ loop.index }}状态切换
const handleDetailToggle{{ loop.index0 }} = (row, field, value) => {
  const toggle = dm{{ loop.index0 }}StatusToggles.find(t => t.field === field)
  const valueLabel = toggle.values[value] || value
  ElMessageBox.confirm(`确定要${valueLabel}吗？`, '提示', { type: 'warning' }).then(() => {
    DM_APIS[{{ loop.index0 }}].toggle({ id: row.id, field, value }).then(() => {
      ElMessage.success('操作成功')
      getDetailList({{ loop.index0 }})
    })
  })
}
{% endif %}
{% endfor %}
{% if module.master.has_batch_operations %}

// 主表批量操作
const handleMasterSelectionChange = (selection) => {
  state.masterSelectIds = selection.map(item => item.id)
}

const handleMasterBatchDelete = () => {
  if (state.masterSelectIds.length === 0) {
    ElMessage.warning('请先选择要删除的记录')
    return
  }
  ElMessageBox.confirm(`确认删除选中的 ${state.masterSelectIds.length} 条记录？关联的明细数据也会被删除！`, '提示', { type: 'warning' }).then(() => {
    api.batchDeleteMaster(state.masterSelectIds).then(() => {
      ElMessage.success('删除成功')
      state.masterSelectIds = []
      masterTableRef.value.clearSelection()
      getMasterList()
    })
  })
}

const handleMasterBatchPhysicalDelete = () => {
  if (state.masterSelectIds.length === 0) {
    ElMessage.warning('请先选择要彻底删除的记录')
    return
  }
  ElMessageBox.confirm(`确认彻底删除选中的 ${state.masterSelectIds.length} 条记录？此操作不可恢复，关联的明细数据也会被删除！`, '警告', { type: 'warning' }).then(() => {
    api.batchPhysicalDeleteMaster(state.masterSelectIds).then(() => {
      ElMessage.success('彻底删除成功')
      state.masterSelectIds = []
      masterTableRef.value.clearSelection()
      getMasterList()
    })
  })
}

// 批量更新（弹窗模式）
const masterBatchUpdateVisible = ref(false)
const masterBatchUpdateLoading = ref(false)
const masterBatchUpdateForm = reactive({
{% for f in module.master.batch_operations["update"]["fields"] %}
  {{ f.name }}: null,
{% endfor %}
})

const openMasterBatchUpdateDialog = () => {
  if (state.masterSelectIds.length === 0) {
    ElMessage.warning('请先选择要操作的记录')
    return
  }
  masterBatchUpdateVisible.value = true
}

const resetMasterBatchUpdateForm = () => {
{% for f in module.master.batch_operations["update"]["fields"] %}
  masterBatchUpdateForm.{{ f.name }} = null
{% endfor %}
}

const submitMasterBatchUpdate = () => {
  const data = {}
{% for f in module.master.batch_operations["update"]["fields"] %}
  if (masterBatchUpdateForm.{{ f.name }} !== null && masterBatchUpdateForm.{{ f.name }} !== '') {
    data['{{ f.name }}'] = masterBatchUpdateForm.{{ f.name }}
  }
{% endfor %}
  if (Object.keys(data).length === 0) {
    ElMessage.warning('请至少填写一个字段')
    return
  }
  masterBatchUpdateLoading.value = true
  api.batchUpdateMaster({ ids: state.masterSelectIds, data }).then(() => {
    ElMessage.success('批量更新成功')
    masterBatchUpdateVisible.value = false
    resetMasterBatchUpdateForm()
    state.masterSelectIds = []
      masterTableRef.value.clearSelection()
    getMasterList()
  }).finally(() => {
    masterBatchUpdateLoading.value = false
  })
}
{% endif %}
