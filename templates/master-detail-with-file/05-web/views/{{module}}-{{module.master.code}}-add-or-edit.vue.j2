<template>
  <div class="edit-container">
    <el-scrollbar>
      <G-back :title="id ? '编辑{{ master_module.name }}' : '新增{{ master_module.name }}'" @go-back="handleBack"></G-back>

      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">基本信息</span></div>
        </template>
        <G-form-add
          ref="formRef"
          :form-data="form"
          :form-rules="rules"
          :form-data-info="formInfo"
          :show-footer="true"
          @call-back-data="handleSubmit"
        />
      </el-card>

{% if has_master_file %}
      <el-card class="mb-20">
        <template #header>
          <div class="card-header"><span class="title">附件材料</span></div>
        </template>
        <el-upload
          :http-request="handleUpload"
          :before-upload="beforeUpload"
          :on-remove="handleRemove"
          :on-preview="handlePreview"
          :file-list="uiFileList"
          multiple
        >
          <el-button type="primary">点击上传</el-button>
          <template #tip>
            <div class="el-upload__tip">
              {% if master_file_types and master_file_types | length > 0 %}支持上传{% for ft in master_file_types %}{{ ft.label }}{% if not loop.last %}、{% endif %}{% endfor %}等文件，{% endif %}单文件不超过50MB
            </div>
          </template>
        </el-upload>
      </el-card>
{% endif %}

      <div style="height: 150px"></div>
    </el-scrollbar>
  </div>
</template>

<script setup>
import { reactive, toRefs, onMounted{% if has_master_file %}, ref{% endif %} } from "vue"
import { ElMessage } from "element-plus"
import api from "@/service/{{ module.domain }}/{{ group_code }}.js"

const props = defineProps({
  id: String
})
const emit = defineEmits(["call-back-data"])

const state = reactive({
  form: {
{% for field in master_fields %}{% if not field.generated %}    {{ field.name }}: {% if field.type == 'select' or field.type == 'date' or field.type == 'datetime' or field.type == 'date-year' or field.type == 'date-month' %}""{% elif field.type == 'number' or field.type == 'decimal' %}0{% else %}""{% endif %},
{% endif %}{% endfor %}{% if has_master_file %}    fileList: [],
{% endif %}  },
  rules: {
{% for field in master_fields %}{% if field.required and not field.generated %}    {{ field.name }}: [{ required: true, message: "{% if field.type == 'select' %}请选择{% else %}请输入{% endif %}{{ field.label }}", trigger: "{% if field.type == 'select' %}change{% else %}blur{% endif %}" }],
{% endif %}{% endfor %}  },
  formInfo: [
{% for field in master_fields %}{% if not field.generated %}    {
      label: "{{ field.label }}",
      prop: "{{ field.name }}",
      type: "{% if field.type == 'select' %}select{% elif field.type == 'date-year' %}date{% elif field.type == 'date-month' %}date{% elif field.type == 'date' %}date{% elif field.type == 'datetime' %}datetime{% elif field.type == 'textarea' %}textarea{% elif field.type == 'number' or field.type == 'decimal' %}number{% else %}input{% endif %}",
      span: 12{% if field.type == 'select' and field.options %},
      options: {{ field.options_json }}{% endif %}{% if field.type == 'date-year' %},
      dateInfo: { type: "year", format: "YYYY", vFormat: "YYYY" }{% elif field.type == 'date-month' %},
      dateInfo: { type: "month", format: "YYYY-MM", vFormat: "YYYY-MM" }{% endif %}
    },
{% endif %}{% endfor %}  ]
})

const { form, rules, formInfo } = toRefs(state)

// 日期字段标准化：兼容 number / ISO / 普通字符串 → 控件所需格式（字符串截取，不做时区换算）
const normalizeDateField = (value, type) => {
  if (value === null || value === undefined || value === '') return ''
  const s = String(value).replace('T', ' ').split('.')[0].split('+')[0].trimEnd()
  if (type === 'date-year') return s.slice(0, 4)
  if (type === 'date-month') return s.slice(0, 7)
  if (type === 'date') return s.slice(0, 10)
  if (type === 'datetime') return s.slice(0, 19)
  return value
}

{% if has_master_file %}
const uiFileList = ref([])
const uploadedFiles = ref([])
const is_uploadedFileList = ref(false)

const beforeUpload = (file) => {
  const isLt50M = file.size / 1024 / 1024 < 50
  if (!isLt50M) {
    ElMessage.error("文件大小不能超过50MB!")
    return false
  }
  return true
}

// 获取附件列表
const getFileList = () => {
  if (!props.id) return
  api.getMasterFileList(props.id).then((res) => {
    uploadedFiles.value = res || []
    uiFileList.value = (res || []).map((f) => ({ name: f.fileName, url: f.fileUrl }))
  }).catch(() => {
    uploadedFiles.value = []
    uiFileList.value = []
  })
}

// 自定义上传方法（携带 Token）
const handleUpload = (options) => {
  const formData = new FormData()
  formData.append('file', options.file)
  is_uploadedFileList.value = true
  api.uploadMasterFile(formData).then((res) => {
    if (res) {
      state.form.fileList.push({
        fileType: "{% if master_file_types and master_file_types | length > 0 %}{{ master_file_types[0].code }}{% else %}annex{% endif %}",
        fileUrl: res.fileUrl,
        fileName: res.fileName
      })
      uiFileList.value.push({
        name: res.fileName,
        url: res.fileUrl,
        uid: options.file.uid
      })
      ElMessage.success("附件上传成功")
      options.onSuccess(res, options.file)
    }
  }).catch((err) => {
    ElMessage.error("上传失败")
    options.onError(err)
  }).finally(() => {
    is_uploadedFileList.value = false
  })
}

const handleRemove = (file) => {
  const idx = state.form.fileList.findIndex(
    f => f.fileUrl === file.url || f.fileName === file.name
  )
  if (idx > -1) {
    state.form.fileList.splice(idx, 1)
  }

  const uiIdx = uiFileList.value.findIndex(
    f => (f.uid && file.uid && f.uid === file.uid) || f.name === file.name
  )
  if (uiIdx > -1) {
    uiFileList.value.splice(uiIdx, 1)
  }
}

const handlePreview = (file) => {
  const found = uiFileList.value.find(f => f.name === file.name)
  const url = (found && found.url) ? found.url : file.url
  if (url) window.open(url, "_blank")
}
{% endif %}

onMounted(() => {
  if (props.id) {
    api.getMasterDetail(props.id).then((res) => {
      if (!res) return
{% if has_master_file %}
      Object.keys(state.form).forEach((key) => {
        if (key !== "fileList" && res[key] !== undefined) state.form[key] = res[key]
      })
{% for field in master_fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] %}      state.form.{{ field.name }} = normalizeDateField(state.form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}      getFileList()
{% else %}
      Object.assign(state.form, res)
{% for field in master_fields %}{% if field.type in ['date-year', 'date-month', 'date', 'datetime'] %}      state.form.{{ field.name }} = normalizeDateField(state.form.{{ field.name }}, '{{ field.type }}')
{% endif %}{% endfor %}{% endif %}
    })
  }
})

const handleSubmit = (val) => {
  if (!val) {
    handleBack()
    return
  }
  if (is_uploadedFileList.value) {
    ElMessage.warning("附件正在上传中，请稍候...")
    return
  }
  const data = {
    ...state.form,
    ...val,
{% if has_master_file %}
    id: props.id,
    fileList: state.form.fileList || []
{% else %}
    id: props.id
{% endif %}
  }
  const request = props.id ? api.updateMaster(data) : api.addMaster(data)
  request.then((res) => {
    if (res !== undefined) {
      ElMessage.success("保存成功")
      emit("call-back-data", 1)
    }
  })
}

const handleBack = () => {
  emit("call-back-data", 0)
}
</script>

<style lang="scss" scoped>
.edit-container {
  .mb-20 {
    margin-bottom: 20px;
  }
  .card-header .title {
    font-weight: bold;
    font-size: 16px;
  }
}
</style>
