-- =====================================================
-- {{ group_name }} 模块数据库脚本
-- 模块组: {{ group_name }} ({{ group_code }})
-- 业务域: {{ master_module.domain_chinese }}
-- 所属系统: {{ project.name }}
-- =====================================================
SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------
-- 1. 清理旧表（先删从表，再删主表）
--    顺序: 明细附件表（可选）→ 明细主表 → 主表附件表（可选）→ 主表
-- ----------------------------
{% if has_detail_file %}
DROP TABLE IF EXISTS `{{ detail_module.table_name }}_file`;
{% endif %}
DROP TABLE IF EXISTS `{{ detail_module.table_name }}`;
{% if has_master_file %}
DROP TABLE IF EXISTS `{{ master_module.table_name }}_file`;
{% endif %}
DROP TABLE IF EXISTS `{{ master_module.table_name }}`;

-- ----------------------------
-- 2. 创建主表（{{ master_module.name }}）
-- ----------------------------
CREATE TABLE `{{ master_module.table_name }}` (
  `id`           BIGINT       NOT NULL                   COMMENT '主键ID（雪花算法）',
{% for field in master_fields %}
  `{{ field.column_name }}`  {{ field.sql_type }}{% if field.sql_length %}({{ field.sql_length }}){% endif %} {% if field.required %}NOT NULL{% else %}DEFAULT NULL{% endif %} COMMENT '{{ field.label }}{% if field.required %}（必填）{% endif %}',
{% endfor %}
  `is_deleted`   INT          NOT NULL DEFAULT 0         COMMENT '逻辑删除：0=正常，1=已删除',
  `create_time`  DATETIME     DEFAULT NULL               COMMENT '创建时间',
  `create_user`  BIGINT       DEFAULT NULL               COMMENT '创建人ID',
  `create_dept`  BIGINT       DEFAULT NULL               COMMENT '创建部门ID（数据权限）',
  `update_time`  DATETIME     DEFAULT NULL               COMMENT '更新时间',
  `update_user`  BIGINT       DEFAULT NULL               COMMENT '更新人ID',
  PRIMARY KEY (`id`){% for field in master_fields %}{% if field.indexed %},
  INDEX `idx_{{ field.column_name }}` (`{{ field.column_name }}`){% endif %}{% endfor %}

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='{{ master_module.name }}主表';

{% if has_master_file %}
-- ----------------------------
-- 3. 创建主表附件从表（{{ master_module.name }}附件，可选）
-- ----------------------------
CREATE TABLE `{{ master_module.table_name }}_file` (
  `id`                       BIGINT       NOT NULL                   COMMENT '主键ID（雪花算法）',
  `{{ master_module.code }}_id` BIGINT    NOT NULL                   COMMENT '关联{{ master_module.name }}主表ID',
  `file_type`                VARCHAR(50)  DEFAULT NULL               COMMENT '附件类型：{% for ft in master_file_types %}{{ ft.code }}={{ ft.label }}{% if not loop.last %}/{% endif %}{% endfor %}',
  `file_url`                 VARCHAR(500) NOT NULL                   COMMENT 'MinIO文件绝对地址',
  `file_name`                VARCHAR(200) DEFAULT NULL               COMMENT '原始文件名（前端回显）',
  `is_deleted`               INT          NOT NULL DEFAULT 0         COMMENT '逻辑删除：0=正常，1=已删除',
  `create_time`              DATETIME     DEFAULT NULL               COMMENT '创建时间',
  `create_user`              BIGINT       DEFAULT NULL               COMMENT '创建人ID',
  `create_dept`              BIGINT       DEFAULT NULL               COMMENT '创建部门ID',
  `update_time`              DATETIME     DEFAULT NULL               COMMENT '更新时间',
  `update_user`              BIGINT       DEFAULT NULL               COMMENT '更新人ID',
  PRIMARY KEY (`id`),
  KEY `idx_{{ master_module.code }}_id` (`{{ master_module.code }}_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='{{ master_module.name }}附件从表';
{% endif %}

-- ----------------------------
-- {% if has_master_file %}4{% else %}3{% endif %}. 创建明细表（{{ detail_module.name }}）
-- ----------------------------
CREATE TABLE `{{ detail_module.table_name }}` (
  `id`                       BIGINT       NOT NULL                   COMMENT '主键ID（雪花算法）',
  `{{ detail_module.master_fk_column }}`  BIGINT NOT NULL            COMMENT '关联{{ master_module.name }}主表ID',
{% for field in detail_fields %}
  `{{ field.column_name }}`  {{ field.sql_type }}{% if field.sql_length %}({{ field.sql_length }}){% endif %} {% if field.required %}NOT NULL{% else %}DEFAULT NULL{% endif %} COMMENT '{{ field.label }}{% if field.required %}（必填）{% endif %}',
{% endfor %}
  `is_deleted`   INT          NOT NULL DEFAULT 0         COMMENT '逻辑删除：0=正常，1=已删除',
  `create_time`  DATETIME     DEFAULT NULL               COMMENT '创建时间',
  `create_user`  BIGINT       DEFAULT NULL               COMMENT '创建人ID',
  `create_dept`  BIGINT       DEFAULT NULL               COMMENT '创建部门ID（数据权限）',
  `update_time`  DATETIME     DEFAULT NULL               COMMENT '更新时间',
  `update_user`  BIGINT       DEFAULT NULL               COMMENT '更新人ID',
  PRIMARY KEY (`id`),
  INDEX `idx_{{ detail_module.master_fk_column }}` (`{{ detail_module.master_fk_column }}`){% for field in detail_fields %}{% if field.indexed %},
  INDEX `idx_{{ field.column_name }}` (`{{ field.column_name }}`){% endif %}{% endfor %}

) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='{{ detail_module.name }}明细表';

{% if has_detail_file %}
-- ----------------------------
-- {% if has_master_file %}5{% else %}4{% endif %}. 创建明细附件从表（{{ detail_module.name }}附件，可选）
-- > 选项A（1:N独立附件表），依据 07-upload 规范
-- ----------------------------
CREATE TABLE `{{ detail_module.table_name }}_file` (
  `id`                        BIGINT       NOT NULL                   COMMENT '主键ID（雪花算法）',
  `{{ detail_module.code }}_id`  BIGINT    NOT NULL                   COMMENT '关联{{ detail_module.name }}明细表ID',
  `file_type`                 VARCHAR(50)  DEFAULT NULL               COMMENT '附件类型：{% for ft in detail_file_types %}{{ ft.code }}={{ ft.label }}{% if not loop.last %}/{% endif %}{% endfor %}',
  `file_url`                  VARCHAR(500) NOT NULL                   COMMENT 'MinIO文件绝对地址',
  `file_name`                 VARCHAR(200) DEFAULT NULL               COMMENT '原始文件名（前端回显）',
  `is_deleted`                INT          NOT NULL DEFAULT 0         COMMENT '逻辑删除：0=正常，1=已删除',
  `create_time`               DATETIME     DEFAULT NULL               COMMENT '创建时间',
  `create_user`               BIGINT       DEFAULT NULL               COMMENT '创建人ID',
  `create_dept`               BIGINT       DEFAULT NULL               COMMENT '创建部门ID',
  `update_time`               DATETIME     DEFAULT NULL               COMMENT '更新时间',
  `update_user`               BIGINT       DEFAULT NULL               COMMENT '更新人ID',
  PRIMARY KEY (`id`),
  KEY `idx_{{ detail_module.code }}_id` (`{{ detail_module.code }}_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='{{ detail_module.name }}附件从表';
{% endif %}

SET FOREIGN_KEY_CHECKS = 1;

{% if has_master_file and has_detail_file %}
SELECT '✅ {{ group_name }} 表结构创建完成（主表+主表附件表+明细表+明细附件表）' AS status;
{% elif has_master_file and not has_detail_file %}
SELECT '✅ {{ group_name }} 表结构创建完成（主表+主表附件表+明细表）' AS status;
{% elif (not has_master_file) and has_detail_file %}
SELECT '✅ {{ group_name }} 表结构创建完成（主表+明细表+明细附件表）' AS status;
{% else %}
SELECT '✅ {{ group_name }} 表结构创建完成（主表+明细表）' AS status;
{% endif %}
